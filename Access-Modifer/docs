// Look:

// class Car {
// private:
//     int speed;


// public:
//     void accelerate() {
//         speed += 10;
//     }
// };

// The compiler sees:

// void accelerate() {
//     speed += 10;
// }

// and checks:

// Who is accessing speed?


// accelerate()


// Where does accelerate() belong?


// Car class


// Is speed private?


// Yes


// Can code inside Car access private members of Car?


// Yes ✅

