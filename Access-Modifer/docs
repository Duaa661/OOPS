// // These are called access specifiers in C++:

// public
// private
// protected

// They control who is allowed to access data members and member functions.

// Think of them as permissions/security levels for your class.

// 1. The basic idea

// Imagine a BankAccount.

// BankAccount
// │
// ├── accountNumber
// ├── holderName
// ├── balance
// └── withdraw()

// Should anyone outside the class be allowed to directly do this?

// account.balance = -100000;

// ❌ No. That could create invalid data.

// So we use private to restrict direct access.

// 2. public

// Anything declared as public can be accessed from outside the class.

// #include <iostream>
// using namespace std;


// class Car {
// public:
//     string brand;


//     void display() {
//         cout << brand << endl;
//     }
// };


// int main() {
//     Car c;


//     c.brand = "BMW";  // Allowed
//     c.display();      // Allowed
// }
// Behind the scenes

// When the compiler sees:

// c.brand = "BMW";

// It checks:

// Is brand accessible from outside Car?
//         │
//         ▼
//       public
//         │
//         ▼
//      YES ✅

// So the compiler allows it.

// 3. private

// A private member can only be accessed inside the same class.

// class Car {
// private:
//     int speed;


// public:
//     void setSpeed(int s) {
//         speed = s;
//     }


//     void displaySpeed() {
//         cout << speed;
//     }
// };

// Now:

// int main() {
//     Car c;


//     c.speed = 100; // ❌ ERROR
// }

// The compiler stops you.

// But this is allowed:

// c.setSpeed(100); // ✅
// Why?

// Because setSpeed() is inside the Car class.

// Outside Code
//      │
//      │ ❌ Cannot directly access
//      ▼
// ┌───────────────────┐
// │      Car          │
// │                   │
// │  private:         │
// │    speed 🔒       │
// │                   │
// │  public:          │
// │    setSpeed() 🔓  │
// └───────────────────┘
// 4. How does C++ stop permission?

// This is important: access control is mainly checked by the compiler.

// Suppose:

// class Car {
// private:
//     int speed;
// };


// int main() {
//     Car c;


//     c.speed = 100;
// }

// When compiling, the compiler knows:

// speed belongs to Car
// speed is private
// main() is outside the Car class

// So it gives an error similar to:

// error: 'speed' is private within this context

// Your program generally won't compile.

// So conceptually:

// Your Code
//     │
//     ▼
// Compiler checks access
//     │
//     ├── public? ──────► Allow ✅
//     │
//     └── private? ─────► Is code inside class?
//                               │
//                          Yes ─┴─ No
//                           │       │
//                         Allow   Error ❌

// It is a language-level access rule, not like a password or operating-system permission system.

